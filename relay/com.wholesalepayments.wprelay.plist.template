<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wholesalepayments.wprelay</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__RELAY__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart if it crashes, but NOT if it exits cleanly. A clean exit is how
       the relay says "a person has to fix something" (a rejected token, a bad
       config); restarting that every ten seconds would bury the one line that
       explains what to do. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
  <key>WorkingDirectory</key>
  <string>__DIR__</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
