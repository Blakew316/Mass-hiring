# Copy this file to .env and fill in what you use.
# Everything here can ALSO be entered in the dashboard's Settings page instead —
# values saved in Settings take precedence over this file.

# Port the dashboard runs on
PORT=3000

# Public URL of this app (needed for Google OAuth redirect + Calendly webhooks).
# For local use: http://localhost:3000
# When deployed: https://your-domain.com
BASE_URL=http://localhost:3000

# --- Google OAuth (optional, recommended) ---
# Lets you import PRIVATE Google Sheets and send email through the Gmail API
# from your work account. Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application -> add redirect URI: {BASE_URL}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail SMTP fallback (optional, easiest) ---
# If you don't want to set up Google OAuth, create an App Password for your
# work Gmail at https://myaccount.google.com/apppasswords and enter it in Settings
# (or here). Emails are then sent over SMTP from that address.
SMTP_USER=
SMTP_PASS=

# --- Calendly (optional) ---
# Signing key used to verify Calendly webhook payloads (shown when you create a
# webhook subscription). Leave blank to accept unsigned webhooks.
CALENDLY_SIGNING_KEY=

# --- Phone notifications via ntfy.sh (optional) ---
# Install the free ntfy app (iOS/Android), subscribe to a unique topic name,
# and put the same topic here or in Settings.
NTFY_TOPIC=
